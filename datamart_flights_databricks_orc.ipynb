= f.size\n","    return total\n","\n","def find_col(patterns, columns):\n","    for p in patterns:\n","        rx = re.compile(p, re.IGNORECASE)\n","        for c in columns:\n","            if rx.fullmatch(c) or rx.search(c):\n","                return c\n","    return None\n","\n","# WORKLOAD — Crear schema + volume y definir paths\n","\n","SCHEMA  = \"flights\"       # \"workspace llamado flights\"\n","VOLUME  = \"data\"          # volume para almacenar landing/curated/functional\n","\n","# Crear schema y volume (SQL)\n","spark.sql(f\"\"\"\n","CREATE SCHEMA IF NOT EXISTS workspace.{SCHEMA}\n","COMMENT 'Schema for Flight Operations Analytics';\n","\"\"\")\n","\n","spark.sql(f\"\"\"\n","CREATE VOLUME IF NOT EXISTS workspace.{SCHEMA}.{VOLUME};\n","\"\"\")\n","\n","# Usar el volume como base\n","BASE_VOLUME_PATH = f\"/Volumes/workspace/{SCHEMA}/{VOLUME}\"\n","\n","# Carpeta donde se subió el dataset Kaggle descomprimido\n","KAGGLE_INPUT_PATH = f\"{BASE_VOLUME_PATH}\"\n","\n","# Capas\n","PATH_WORKLOAD   = f\"{BASE_VOLUME_PATH}/workload\"\n","PATH_LANDING    = f\"{BASE_VOLUME_PATH}/landing/flights\"\n","PATH_CURATED    = f\"{BASE_VOLUME_PATH}/curated/flights\"\n","PATH_FUNCTIONAL = f\"{BASE_VOLUME_PATH}/functional/datamart\"\n","\n","\n","DB_NAME = SCHEMA\n","\n","print(\"DB_NAME:\", DB_NAME)\n","print(\"BASE_VOLUME_PATH:\", BASE_VOLUME_PATH)\n","print(\"KAGGLE_INPUT_PATH:\", KAGGLE_INPUT_PATH)\n","print(\"PATH_LANDING:\", PATH_LANDING)\n","print(\"PATH_CURATED:\", PATH_CURATED)\n","print(\"PATH_FUNCTIONAL:\", PATH_FUNCTIONAL)\n"]},{"cell_type":"markdown","metadata":{"application/vnd.databricks.v1+cell":{"cellMetadata":{},"inputWidgets":{},"nuid":"f6a17232-08be-4b6c-a4d1-a9d25fe90ec4","showTitle":false,"tableResultSettingsMap":{},"title":""},"id":"HofJHnIAVboA"},"source":["### 0.1 Inspección de archivos de entrada (Kaggle)"]},{"cell_type":"code","execution_count":null,"metadata":{"application/vnd.databricks.v1+cell":{"cellMetadata":{"byteLimit":2048000,"rowLimit":1000